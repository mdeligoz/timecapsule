{
  "name": "timecapsule",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // The send job: at most one letter per run.
  "triggers": { "crons": ["* * * * *"] },
  // The Write letter, Settings and setup screens' scripts are bundled into public/ before every dev run and deploy.
  "build": {
    "command": "npx esbuild src/browser/write.ts src/browser/settings.ts src/browser/setup.ts --bundle --format=esm --minify --outdir=public",
    "watch_dir": "src/browser"
  },
  "assets": { "directory": "public" },
  // The stylesheet is also bundled as text, for the pages shown before login, where Access guards public/ too.
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],
  // Setup finds this Worker's account by the running version's id.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // No vars: a deploy resets every var to this file, but leaves secrets alone. Setup stores every setting as a secret:
  // the owner's email, the sending domain and the Resend key as typed on its page, and the rest, the bucket's name
  // included, read from the running version's FILES binding.
  "d1_databases": [{ "binding": "DB", "database_name": "timecapsule", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "timecapsule" }]
}
