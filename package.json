    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "marked": "18.1.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    },
    "@cloudflare/vitest-plugin": {
